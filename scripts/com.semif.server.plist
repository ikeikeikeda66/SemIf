<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.semif.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/SSD_USB_1/AntiGravitiRoot/semlf/scripts/run_server.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/SSD_USB_1/AntiGravitiRoot/semlf</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/ikedashinichi/.local/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ikedashinichi/Library/Logs/semif-server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ikedashinichi/Library/Logs/semif-server-error.log</string>
</dict>
</plist>
